{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/structure-garde.sh\"",
            "timeout": 10,
            "statusMessage": "Charte de structure"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/refus-bash.sh\"",
            "timeout": 120,
            "statusMessage": "Les trois refus"
          }
        ]
      }
    ]
  }
}
